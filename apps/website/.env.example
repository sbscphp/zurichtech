# ---------------------------------------------------------------------------
# Sanity CMS (read-only, public)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Leave false (or unset) so Studio publishes appear immediately on the website.
NEXT_PUBLIC_SANITY_USE_CDN=false

# Optional: Sanity webhook secret for instant cache busting
# (sent as the `x-revalidate-secret` header to /api/revalidate)
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# External backend API (contact form + newsletter)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=
