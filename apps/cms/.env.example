SANITY_STUDIO_PROJECT_ID=
# Use development for local Studio + seeding. Keep production for deploy-only envs.
SANITY_STUDIO_DATASET=development
SANITY_STUDIO_HOSTNAME=zuritech

# Editor token — required only for seed commands (never commit the real token).
SANITY_API_WRITE_TOKEN=

# Do not set SEED_ALLOW_PRODUCTION here. Use `pnpm --filter cms seed:production` explicitly.
